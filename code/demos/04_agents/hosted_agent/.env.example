# Local development only. Foundry supplies FOUNDRY_PROJECT_ENDPOINT to the
# deployed container, and other FOUNDRY_* names are reserved by the hosted
# runtime -- do not invent new ones.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini
TOOLBOX_NAME=skeptic-tools
