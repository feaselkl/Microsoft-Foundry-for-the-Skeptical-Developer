# Microsoft Foundry project endpoint.
# Portal -> your project -> Overview -> Endpoints
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# The name YOU gave your model deployment. Not necessarily the model's name --
# that distinction is a teaching point in demo 3.
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# A model NAME for the instant access demo (preview; no deployment required).
# Instant access requires a project in West US 3 during preview.
FOUNDRY_INSTANT_MODEL=gpt-5-mini

# Agent name used by demos 4 and 5.
FOUNDRY_AGENT_NAME=SkepticalDeveloperAgent

# Authentication is Entra ID only -- run `az login`. There is no API key
# option for the project client, so there is no key to put here.

# Written by infra/deploy-mcp-server.sh -- the demo-4 MCP feature registry.
FOUNDRY_MCP_SERVER_URL=

# Toolbox name for demo 4 step 3. The hosted agent resolves the toolbox from
# this name, so promoting a new toolbox version needs no agent redeploy.
FOUNDRY_TOOLBOX_NAME=skeptic-tools

# Hosted agent name for demo 4 step 4.
FOUNDRY_HOSTED_AGENT_NAME=skeptic-assessor
